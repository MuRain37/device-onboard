#!/bin/sh
set -eu
CONFIG_FILE=${DEVICE_ONBOARD_CONFIG_FILE:-"$HOME/.config/device-onboard/config"}
if [ ! -f "$CONFIG_FILE" ]; then
    printf '错误：还没有设备接入配置，请先运行 install.sh。\n' >&2
    exit 1
fi
. "$CONFIG_FILE"
: "${TUNNEL_HOST_ALIAS:?配置缺少 TUNNEL_HOST_ALIAS}"

# Termux（Android）会在后台回收进程；隧道必须持有唤醒锁，否则会被系统掐断。
if [ -n "${TERMUX_VERSION:-}" ]; then
    command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1 || true
fi

printf '正在建立反向 SSH 隧道；保持此窗口，按 Ctrl-C 结束。\n'
# 不用 -N：改成让服务器端跑一个「只负责报喜、然后挂住保持连接」的命令。
# 通道的 Host 块里有 ExitOnForwardFailure yes —— 转发真绑上了才会执行到那几行，
# 所以这句「已建立」是服务器亲口说的，不是本地瞎报。
exec ssh "$TUNNEL_HOST_ALIAS" "\
printf '✅ 反向隧道已建立\n'; \
printf '   服务器 127.0.0.1:${REVERSE_PORT}  →  本机 localhost:${DEVICE_PORT}\n'; \
printf '   断开：Ctrl-C\n'; \
exec sleep 2147483647"
