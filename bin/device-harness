#!/bin/sh
# 一条命令做完两件事：起反向隧道 + 在服务器上跑 harness（默认 codex）。
# 两者同生共死 —— harness 一退出（或按 Ctrl-C），隧道跟着收掉。
#
# 用法：
#   device-harness                    默认跑 codex
#   device-harness claude             换别的 harness —— 第一个参数是什么就起什么
#   device-harness -C '~/proj' claude 先给工作目录，再给 harness 命令
#   device-harness claude -p '活'     命令后面的参数原样传给 harness
#
# 分成两个命令不行就在于「生命期」：隧道是后台长跑，harness 是前台交互，
# 中间断了谁都发现不了。这里把它们绑一起，退出时一定收干净。
set -eu

CONFIG_FILE=${DEVICE_ONBOARD_CONFIG_FILE:-"$HOME/.config/device-onboard/config"}
if [ ! -f "$CONFIG_FILE" ]; then
    printf '错误：还没有设备接入配置，请先运行 install.sh。\n' >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$CONFIG_FILE"
: "${TUNNEL_HOST_ALIAS:?配置缺少 TUNNEL_HOST_ALIAS}"
: "${SERVER_HOST_ALIAS:?配置缺少 SERVER_HOST_ALIAS}"
: "${DEVICE_ID:?配置缺少 DEVICE_ID}"
: "${DEVICE_HOST_ALIAS:?配置缺少 DEVICE_HOST_ALIAS}"

# 选项：
#   -C <目录>   指定服务器上的工作目录（优先级最高）
# 之后第一个参数是 harness 命令，剩余参数原样传给它。
DIR=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -C)
            if [ "$#" -lt 2 ]; then
                printf '错误：-C 后面要跟一个目录（服务器上的路径）。\n' >&2
                exit 2
            fi
            DIR=$2
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

# 没给 -C 时，默认落在服务器家目录。设备身份不靠工作目录表示 ——
# 本次会话来自哪台设备，由 ssh 带过去的 DEVICE_ONBOARD_ID /
# DEVICE_ONBOARD_DEVICE_ALIAS 环境变量传递（见文件末尾）。
[ -n "$DIR" ] || DIR='$HOME'

# 目录是「服务器上」的路径。~ 要留给服务器展开：
# 如果写成 ~/phone，手机上那个 shell 会先把它展开成手机的路径（错），
# 所以请用单引号：device-harness -C '~/phone'。这里再把 ~ 换成 $HOME，
# 交给远端的 shell 去解析。
case "$DIR" in
    '~')    DIR='$HOME' ;;
    '~/'*)  DIR="\$HOME/${DIR#\~/}" ;;
esac

HARNESS_CMD=codex
if [ "$#" -gt 0 ]; then
    HARNESS_CMD=$1
    shift
fi

# 交互式 Codex 把「执行工具命令」交给常驻的 app-server 守护进程，继承的是守护进程
# 启动那一刻的环境 —— 所以 ssh 带过去的 DEVICE_ONBOARD_* 到不了它的工具手上
# （实测：工具 shell 里的 SSH_CLIENT 与两天前的守护进程逐字一致）。
# --no-daemon 让它在本次会话的进程里执行工具，环境变量就有效了。
# 用前缀匹配而不是精确匹配：写成 `codex --model X` 时也要带上。
case "$HARNESS_CMD" in
    codex*) HARNESS_CMD="$HARNESS_CMD --no-daemon" ;;
esac

# codex 用它自己的 -C 指定工作目录；别的命令就 cd 过去再跑。
# 用双引号：这样 $DIR 里若是 $HOME，交给远端 shell 去展开。
case "$HARNESS_CMD" in
    codex*) RUN_CMD="$HARNESS_CMD -C \"$DIR\"" ;;
    *)      RUN_CMD="cd \"$DIR\" && $HARNESS_CMD" ;;
esac

# 单引号转义：' -> '\''
# 两处要用：① harness 的剩余参数（可能带空格，例如 -p '一段话'）
#            ② 设备侧当前目录（可能带空格或引号）
# 不转义就会被远端 shell 拆散或展开 —— 前者是功能错，后者是注入口子。
squote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# 剩余参数原样传给 harness：逐个转义后再拼，带空格/引号的参数才不会被拆散
# （实测过：不转义时 `-p 'two words here'` 到远端会变成 4 个参数）。
for _arg in "$@"; do
    RUN_CMD="$RUN_CMD $(squote "$_arg")"
done

# ---------- 设备侧当前目录：作为「上下文」带给服务器上的 harness ----------
# 注意定位：这是「用户当时站在哪」，是上下文，**不是身份**。身份仍只有
# DEVICE_ONBOARD_ID 一个 —— 目录可以随处 cd，身份不行。
#
# 用它的是谁：服务器上的 agent。它想知道「要去哪台设备的哪个目录看文件」时，
# 不必再猜一轮。绝对路径给「过去操作」用；相对家目录的短名给人看、给将来取名用。
#
# 拼进远端命令行前一律 squote（上面已定义）：目录名可能带空格或引号（macOS 上很常见）。
DEVICE_CWD=$(pwd -P 2>/dev/null || pwd)
case "$DEVICE_CWD" in
    "$HOME")   DEVICE_CWD_REL='.' ;;          # 就在家目录
    "$HOME"/*) DEVICE_CWD_REL=${DEVICE_CWD#"$HOME"/} ;;
    *)         DEVICE_CWD_REL='' ;;           # 在家目录之外（空值有明确含义）
esac

# device-tunnel 正常装在 PATH 里；找不到就退回脚本自己所在的目录。
TUNNEL_BIN=$(command -v device-tunnel 2>/dev/null || true)
[ -n "$TUNNEL_BIN" ] || TUNNEL_BIN=$(dirname "$0")/device-tunnel
if [ ! -x "$TUNNEL_BIN" ]; then
    printf '错误：找不到 device-tunnel，请先跑 install.sh 装好本地命令。\n' >&2
    exit 1
fi

# 隧道这次跑在后台，前台留给 harness —— 所以更要拿住唤醒锁，
# 否则 Android 会把整个 App 冻上，隧道看着还在、实际已经握手不能了。
if [ -n "${TERMUX_VERSION:-}" ]; then
    command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1 || true
fi

# 就绪信号不靠「端口在不在听」，而是等隧道自己打出的那行「✅ 反向隧道已建立」——
# 那是服务器亲口说的（Host 块里 ExitOnForwardFailure yes：转发真绑上才会执行到那行）。
# Termux 上 /tmp 不可写，临时文件必须用 $TMPDIR。
READY_FILE=$(mktemp "${TMPDIR:-/tmp}/device-harness.XXXXXX" 2>/dev/null || mktemp)
tunnel_pid=

cleanup() {
    if [ -n "$tunnel_pid" ] && kill -0 "$tunnel_pid" 2>/dev/null; then
        kill "$tunnel_pid" 2>/dev/null || true
        wait "$tunnel_pid" 2>/dev/null || true
        printf '\n隧道已收起。\n'
    fi
    [ -f "$READY_FILE" ] && rm -f "$READY_FILE"
}
trap cleanup EXIT INT TERM

printf '正在建立反向 SSH 隧道…\n'
"$TUNNEL_BIN" >"$READY_FILE" 2>&1 </dev/null &
tunnel_pid=$!

waited=0
while [ "$waited" -lt 60 ]; do
    grep -q '反向隧道已建立' "$READY_FILE" 2>/dev/null && break
    if ! kill -0 "$tunnel_pid" 2>/dev/null; then
        printf '隧道进程退出了，没等到就绪。输出：\n' >&2
        sed 's/^/    /' "$READY_FILE" >&2
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

if ! grep -q '反向隧道已建立' "$READY_FILE" 2>/dev/null; then
    printf '等了 %s 秒没等到隧道就绪。最后几行输出：\n' "$waited" >&2
    tail -5 "$READY_FILE" | sed 's/^/    /' >&2
    exit 1
fi

printf '隧道就绪。在服务器上启动 %s（退出后隧道自动收起）…\n\n' "$HARNESS_CMD"

# 把「本次会话来自哪台设备」和「设备侧当时在哪个目录」交给 harness。变量名和用法写在
# 服务器上那份设备档案 + ~/.codex/AGENTS.md 里 —— 会话一开始就能看到。
# 设备 ID / 别名来自配置（install 已限定字符集），但目录是任意内容，一律 squote 转义。
# 必须 export：RUN_CMD 常是 "cd <目录> && <命令>" 这种复合命令，
# 而 "VAR=x cd <目录> && 命令" 里的赋值只贴在 cd 这一个命令上（bash 下 cd 不是
# special builtin，赋值不留在 shell 里）→ cd 之后的命令根本看不到这几个变量。
# 真机踩过：device-harness sh -c 'env | grep DEVICE_ONBOARD' 一行都打不出来。
ENV_PREFIX="export DEVICE_ONBOARD_ID=$(squote "$DEVICE_ID") DEVICE_ONBOARD_DEVICE_ALIAS=$(squote "$DEVICE_HOST_ALIAS") DEVICE_ONBOARD_DEVICE_CWD=$(squote "$DEVICE_CWD") DEVICE_ONBOARD_DEVICE_CWD_REL=$(squote "$DEVICE_CWD_REL");"
ssh -t "$SERVER_HOST_ALIAS" "$ENV_PREFIX $RUN_CMD"
