#!/bin/sh
# 一条命令做完两件事：起反向隧道 + 在服务器上跑 harness（默认 codex）。
# 两者同生共死 —— harness 一退出（或按 Ctrl-C），隧道跟着收掉。
#
# 用法：
#   device-harness                    默认跑 codex
#   device-harness claude             换别的 harness —— 第一个参数是什么就起什么
#   device-harness -C '~/proj' claude 先给工作目录，再给 harness 命令
#   device-harness claude -p '活'     命令后面的参数原样传给 harness
#   device-harness dsh                起服务器上的 `dsh web`，并把那个网页转到设备的 127.0.0.1
#                                     （dsh 是网页 GUI，不是终端会话 —— 见 run_web_session）
#
# 分成两个命令不行就在于「生命期」：隧道是后台长跑，harness 是前台交互，
# 中间断了谁都发现不了。这里把它们绑一起，退出时一定收干净。
set -eu

CONFIG_FILE=${DEVICE_ONBOARD_CONFIG_FILE:-"$HOME/.config/device-onboard/config"}
if [ ! -f "$CONFIG_FILE" ]; then
    printf '错误：还没有设备接入配置，请先运行 install.sh。\n' >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$CONFIG_FILE"
: "${SERVER_HOST_ALIAS:?配置缺少 SERVER_HOST_ALIAS}"
: "${DEVICE_ID:?配置缺少 DEVICE_ID}"
: "${DEVICE_HOST_ALIAS:?配置缺少 DEVICE_HOST_ALIAS}"

# 选项：
#   -C <目录>   指定服务器上的工作目录（优先级最高）
# 之后第一个参数是 harness 命令，剩余参数原样传给它。
DIR=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -C)
            if [ "$#" -lt 2 ]; then
                printf '错误：-C 后面要跟一个目录（服务器上的路径）。\n' >&2
                exit 2
            fi
            DIR=$2
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

# 没给 -C 时，默认落在服务器家目录。设备身份不靠工作目录表示 ——
# 本次会话来自哪台设备，由 ssh 带过去的 DEVICE_ONBOARD_ID /
# DEVICE_ONBOARD_DEVICE_ALIAS 环境变量传递（见文件末尾）。
[ -n "$DIR" ] || DIR='$HOME'

# 目录是「服务器上」的路径。~ 要留给服务器展开：
# 如果写成 ~/phone，手机上那个 shell 会先把它展开成手机的路径（错），
# 所以请用单引号：device-harness -C '~/phone'。这里再把 ~ 换成 ${HOME}，
# 交给远端的 shell 去解析。
case "$DIR" in
    '~')    DIR='$HOME' ;;
    '~/'*)  DIR="\$HOME/${DIR#\~/}" ;;
esac

HARNESS_CMD=codex
if [ "$#" -gt 0 ]; then
    HARNESS_CMD=$1
    shift
fi

# dsh 是「在浏览器里用」的 harness：`dsh web` 起的是一个只绑 loopback 的 Web GUI，
# 不是一个交互式终端会话。所以它的编排跟 codex/claude 完全不同 —— 见 run_web_session：
# 服务器上起 dsh web，再用 SSH 本地转发把它搬到设备的 127.0.0.1 上。
WEB_MODE=0
case "$HARNESS_CMD" in
    dsh) WEB_MODE=1 ;;
esac

# 交互式 Codex 把「执行工具命令」交给常驻的 app-server 守护进程，继承的是守护进程
# 启动那一刻的环境 —— 所以 ssh 带过去的 DEVICE_ONBOARD_* 到不了它的工具手上
# （实测：工具 shell 里的 SSH_CLIENT 与两天前的守护进程逐字一致）。
# --no-daemon 让它在本次会话的进程里执行工具，环境变量就有效了。
# 用前缀匹配而不是精确匹配：写成 `codex --model X` 时也要带上。
case "$HARNESS_CMD" in
    codex*) HARNESS_CMD="$HARNESS_CMD --no-daemon" ;;
esac

# codex 用它自己的 -C 指定工作目录；别的命令就 cd 过去再跑。
# 用双引号：这样 $DIR 里若是 ${HOME}，交给远端 shell 去展开。
# WEB_MODE（dsh）走另一条路：它的服务器端命令要等端口定下来才拼，见 run_web_session。
RUN_CMD=
if [ "$WEB_MODE" = 0 ]; then
    case "$HARNESS_CMD" in
        codex*) RUN_CMD="$HARNESS_CMD -C \"$DIR\"" ;;
        *)      RUN_CMD="cd \"$DIR\" && $HARNESS_CMD" ;;
    esac
fi

# 单引号转义：' -> '\''
# 两处要用：① harness 的剩余参数（可能带空格，例如 -p '一段话'）
#            ② 设备侧当前目录（可能带空格或引号）
# 不转义就会被远端 shell 拆散或展开 —— 前者是功能错，后者是注入口子。
squote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# 剩余参数原样传给 harness：逐个转义后再拼，带空格/引号的参数才不会被拆散
# （实测过：不转义时 `-p 'two words here'` 到远端会变成 4 个参数）。
WEB_EXTRA=
for _arg in "$@"; do
    if [ "$WEB_MODE" = 0 ]; then
        RUN_CMD="$RUN_CMD $(squote "$_arg")"
        continue
    fi
    # 端口由本命令统一分配：服务器上 dsh web 的监听端口和设备侧 -L 的目标端口
    # 必须是同一个号。用户自己传 --port 会让两者错开，症状是「网页打不开」而
    # 没有任何报错指向端口 —— 所以直接拒绝，并说清该改哪儿。
    case "$_arg" in
        --port|--port=*|-p)
            printf '错误：dsh 的端口由 device-harness 统一分配，别传 --port / -p。\n' >&2
            printf '      要换起点：DEVICE_ONBOARD_DSH_WEB_PORT=9300 device-harness dsh\n' >&2
            exit 2
            ;;
    esac
    WEB_EXTRA="$WEB_EXTRA $(squote "$_arg")"
done

# ---------- 设备侧当前目录：作为「上下文」带给服务器上的 harness ----------
# 注意定位：这是「用户当时站在哪」，是上下文，**不是身份**。身份仍只有
# DEVICE_ONBOARD_ID 一个 —— 目录可以随处 cd，身份不行。
#
# 用它的是谁：服务器上的 agent。它想知道「要去哪台设备的哪个目录看文件」时，
# 不必再猜一轮。绝对路径给「过去操作」用；相对家目录的短名给人看、给将来取名用。
#
# 拼进远端命令行前一律 squote（上面已定义）：目录名可能带空格或引号（macOS 上很常见）。
DEVICE_CWD=$(pwd -P 2>/dev/null || pwd)
case "$DEVICE_CWD" in
    "$HOME")   DEVICE_CWD_REL='.' ;;          # 就在家目录
    "$HOME"/*) DEVICE_CWD_REL=${DEVICE_CWD#"$HOME"/} ;;
    *)         DEVICE_CWD_REL='' ;;           # 在家目录之外（空值有明确含义）
esac

# device-tunnel 正常装在 PATH 里；找不到就退回脚本自己所在的目录。
TUNNEL_BIN=$(command -v device-tunnel 2>/dev/null || true)
[ -n "$TUNNEL_BIN" ] || TUNNEL_BIN=$(dirname "$0")/device-tunnel
if [ ! -x "$TUNNEL_BIN" ]; then
    printf '错误：找不到 device-tunnel，请先跑 install.sh 装好本地命令。\n' >&2
    exit 1
fi

# 隧道这次跑在后台，前台留给 harness —— 所以更要拿住唤醒锁，
# 否则 Android 会把整个 App 冻上，隧道看着还在、实际已经握手不能了。
if [ -n "${TERMUX_VERSION:-}" ]; then
    command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1 || true
fi

# 就绪信号不靠「端口在不在听」，而是等隧道自己打出的那行「✅ 反向隧道已建立」——
# 那是服务器亲口说的（device-tunnel 带 -o ExitOnForwardFailure=yes：转发真绑上才会执行到那行）。
# Termux 上 /tmp 不可写，临时文件必须用 ${TMPDIR}。
READY_FILE=$(mktemp "${TMPDIR:-/tmp}/device-harness.XXXXXX" 2>/dev/null || mktemp)
WEB_LOG=$(mktemp "${TMPDIR:-/tmp}/device-harness-web.XXXXXX" 2>/dev/null || mktemp)
tunnel_pid=
web_pid=
web_remote_port=

cleanup() {
    if [ -n "$web_pid" ] && kill -0 "$web_pid" 2>/dev/null; then
        kill "$web_pid" 2>/dev/null || true
        wait "$web_pid" 2>/dev/null || true
    fi
    # 兜底：远端那个 trap 万一没跑到（比如 sshd 直接掐了整个会话组），
    # dsh web 会留在服务器上把端口占着。补一枪按端口精确匹配的 pkill ——
    # 端口是本次会话独有的，不会误伤别的设备。连不上就算了，别卡住退出流程。
    if [ -n "${web_remote_port:-}" ]; then
        ssh -o BatchMode=yes -o ConnectTimeout=5 "$SERVER_HOST_ALIAS" \
            "pkill -TERM -f 'dsh web.*--host 127.0.0.1 --port $web_remote_port'" \
            >/dev/null 2>&1 || true
    fi
    if [ -n "$tunnel_pid" ] && kill -0 "$tunnel_pid" 2>/dev/null; then
        kill "$tunnel_pid" 2>/dev/null || true
        wait "$tunnel_pid" 2>/dev/null || true
        printf '\n隧道已收起。\n'
    fi
    rm -f "$READY_FILE" "$WEB_LOG" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

printf '正在建立反向 SSH 隧道…\n'
"$TUNNEL_BIN" >"$READY_FILE" 2>&1 </dev/null &
tunnel_pid=$!

waited=0
while [ "$waited" -lt 60 ]; do
    grep -q '反向隧道已建立' "$READY_FILE" 2>/dev/null && break
    if ! kill -0 "$tunnel_pid" 2>/dev/null; then
        printf '隧道进程退出了，没等到就绪。输出：\n' >&2
        sed 's/^/    /' "$READY_FILE" >&2
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

if ! grep -q '反向隧道已建立' "$READY_FILE" 2>/dev/null; then
    printf '等了 %s 秒没等到隧道就绪。最后几行输出：\n' "$waited" >&2
    tail -5 "$READY_FILE" | sed 's/^/    /' >&2
    exit 1
fi

if [ "$WEB_MODE" = 1 ]; then
    printf '隧道就绪。在服务器上启动 dsh web（Ctrl-C 结束，dsh web 与隧道一起收）…\n\n'
else
    printf '隧道就绪。在服务器上启动 %s（退出后隧道自动收起）…\n\n' "$HARNESS_CMD"
fi

# 把「本次会话来自哪台设备」和「设备侧当时在哪个目录」交给 harness。变量名和用法写在
# 服务器上那份设备档案 + ~/.codex/AGENTS.md 里 —— 会话一开始就能看到。
# 设备 ID / 别名来自配置（install 已限定字符集），但目录是任意内容，一律 squote 转义。
# 必须 export：RUN_CMD 常是 "cd <目录> && <命令>" 这种复合命令，
# 而 "VAR=x cd <目录> && 命令" 里的赋值只贴在 cd 这一个命令上（bash 下 cd 不是
# special builtin，赋值不留在 shell 里）→ cd 之后的命令根本看不到这几个变量。
# 真机踩过：device-harness sh -c 'env | grep DEVICE_ONBOARD' 一行都打不出来。
ENV_PREFIX="export DEVICE_ONBOARD_ID=$(squote "$DEVICE_ID") DEVICE_ONBOARD_DEVICE_ALIAS=$(squote "$DEVICE_HOST_ALIAS") DEVICE_ONBOARD_DEVICE_CWD=$(squote "$DEVICE_CWD") DEVICE_ONBOARD_DEVICE_CWD_REL=$(squote "$DEVICE_CWD_REL");"

# ---------- dsh：把服务器的 Web GUI 搬到设备的 127.0.0.1 ----------
# dsh web 只绑 loopback（`--host 0.0.0.0` 明确不支持），所以「在设备上打开网页」
# 天然就是 SSH 本地转发该干的活：设备 127.0.0.1:<端口> → 服务器 127.0.0.1:<端口>。
# 两边取同一个端口号，dsh 打印的那条带凭据的 URL 就能在设备上原样点开 ——
# 它的浏览器请求校验要求 Host 是 loopback，转发之后 Host 仍是 127.0.0.1，照样通过。
WEB_PORT_START=${DEVICE_ONBOARD_DSH_WEB_PORT:-9230}
WEB_PORT_END=${DEVICE_ONBOARD_DSH_WEB_PORT_END:-9299}
WEB_WAIT=${DEVICE_ONBOARD_DSH_WAIT:-180}

# 服务器上有没有 dsh：没有就说清楚，别让人对着 ssh 的退出码猜。
server_has_dsh() {
    ssh "$SERVER_HOST_ALIAS" 'command -v dsh >/dev/null 2>&1 || [ -x "$HOME/.local/bin/dsh" ]' 2>/dev/null
}

# 服务器侧挑端口：dsh web 要在这个端口上监听 loopback。
# 没有 ss 的命令就按「没人听」处理 —— 真撞了 dsh 会自己报 EADDRINUSE，报错照样看得见。
server_free_web_port() {
    _script=$(printf 'p=%s; end=%s; while [ "$p" -le "$end" ]; do if [ -z "$(ss -ltn "sport = :$p" 2>/dev/null | tail -n +2)" ]; then printf "%%s" "$p"; exit 0; fi; p=$((p+1)); done; exit 1' "$WEB_PORT_START" "$WEB_PORT_END")
    ssh "$SERVER_HOST_ALIAS" "$_script" 2>/dev/null
}

# 设备侧挑端口：要保证 -L 能在本机 127.0.0.1 上绑得上。有 nc 就问一句，
# 没有就当作空闲（真绑不上时 ssh 会明确报 "cannot listen to port"，不会静默）。
device_port_free() {
    if command -v nc >/dev/null 2>&1; then
        ! nc -z 127.0.0.1 "$1" >/dev/null 2>&1
    else
        return 0
    fi
}

run_web_session() {
    case "$WEB_PORT_START" in ''|*[!0-9]*) printf '错误：DEVICE_ONBOARD_DSH_WEB_PORT 不是数字：%s\n' "$WEB_PORT_START" >&2; return 1 ;; esac
    case "$WEB_PORT_END"   in ''|*[!0-9]*) printf '错误：DEVICE_ONBOARD_DSH_WEB_PORT_END 不是数字：%s\n' "$WEB_PORT_END" >&2; return 1 ;; esac

    if ! server_has_dsh; then
        printf '服务器上找不到 dsh 命令 —— 先在服务器上把 DeepSeek Harness 装好。\n' >&2
        return 1
    fi

    remote_port=$(server_free_web_port || true)
    case "$remote_port" in
        ''|*[!0-9]*)
            printf '服务器上 %s-%s 里没有空闲端口能给 dsh web。\n' "$WEB_PORT_START" "$WEB_PORT_END" >&2
            return 1
            ;;
    esac

    # 优先用同一个号（URL 一个字都不用改）；设备上被占才顺位，并把 URL 里的端口改掉。
    local_port=
    _p=$remote_port
    while [ "$_p" -le "$WEB_PORT_END" ]; do
        if device_port_free "$_p"; then local_port=$_p; break; fi
        _p=$((_p + 1))
    done
    if [ -z "$local_port" ]; then
        printf '设备上 %s-%s 都占着，没有端口可以转发 dsh web。\n' "$remote_port" "$WEB_PORT_END" >&2
        return 1
    fi

    # 用户的多余参数放最后：让他的 --trusted-host 之类压过我们的默认值。
    # dsh web 是服务器上的进程，凭「杀掉本地 ssh」收不干净 —— 实测：ssh 断了之后
    # node 那个进程还在，端口一直占着（它不听 SIGHUP）。所以远端自己带一个 trap：
    # 会话收到 HUP/TERM 就把 dsh web 一起带走。本地 ssh 断连 → sshd 给会话发 HUP → 收干净。
    _web_cmd="cd \"$DIR\" || exit 1
dsh web --no-open --host 127.0.0.1 --port $remote_port$WEB_EXTRA </dev/null &
_web_child=\$!
trap 'kill -TERM \"\$_web_child\" 2>/dev/null' HUP TERM INT EXIT
wait \"\$_web_child\""

    printf '在服务器上启动 dsh web（127.0.0.1:%s），转发到设备 127.0.0.1:%s …\n' "$remote_port" "$local_port"
    web_remote_port=$remote_port
    : > "$WEB_LOG"
    ssh -o ExitOnForwardFailure=yes -o ServerAliveInterval=60 -o ServerAliveCountMax=3 \
        -L "${local_port}:localhost:${remote_port}" \
        "$SERVER_HOST_ALIAS" "$ENV_PREFIX $_web_cmd" >>"$WEB_LOG" 2>&1 </dev/null &
    web_pid=$!

    # 就绪信号照样由服务器说：dsh web 自己打印的那行 `dsh web: <URL>`。
    # 不等端口、也不信「我发出去了」—— 没打出这行就是没起来。
    _waited=0
    _url=
    while [ "$_waited" -lt "$WEB_WAIT" ]; do
        _url=$(sed -n 's/^dsh web: //p' "$WEB_LOG" 2>/dev/null | tail -1)
        [ -n "$_url" ] && break
        if ! kill -0 "$web_pid" 2>/dev/null; then
            printf 'dsh web 退出了，没打出 URL。输出：\n' >&2
            sed 's/^/    /' "$WEB_LOG" >&2
            web_pid=
            return 1
        fi
        sleep 1
        _waited=$((_waited + 1))
    done
    if [ -z "$_url" ]; then
        printf '等了 %s 秒没等到 dsh web 打印 URL。最后几行输出：\n' "$_waited" >&2
        tail -5 "$WEB_LOG" | sed 's/^/    /' >&2
        return 1
    fi

    # 端口被占换过号时，URL 里的端口得跟着换；Host 仍是 127.0.0.1，dsh 的校验照旧通过。
    _device_url=$_url
    if [ "$local_port" != "$remote_port" ]; then
        _device_url=$(printf '%s\n' "$_url" | sed "s|:$remote_port|:$local_port|")
        printf '\n注意：设备上 %s 已被占用，改用 %s（URL 里的端口已替你改好）。\n' "$remote_port" "$local_port"
    fi

    printf '\n✅ dsh web 已就绪。在设备浏览器里打开：\n\n    %s\n\n' "$_device_url"
    printf '   这条 URL 带着一次性凭据，别外发。Ctrl-C 结束（dsh web 与隧道一起收）。\n\n'

    wait "$web_pid" 2>/dev/null || true
    web_pid=
    printf '\ndsh web 已退出。最后几行输出：\n'
    tail -5 "$WEB_LOG" 2>/dev/null | sed 's/^/    /' || true
}

if [ "$WEB_MODE" = 1 ]; then
    run_web_session
    exit $?
fi

ssh -t "$SERVER_HOST_ALIAS" "$ENV_PREFIX $RUN_CMD"
