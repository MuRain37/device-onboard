#!/bin/sh
# device-view —— 给这个会话一个「命令落到设备上」的视图。**不挂载任何文件系统。**
#
# 做的两件事（都只在会话自己的命名空间里生效，退出即消失）：
#   ① /usr/bin/{bash,zsh} 换成转发垫片（codex 走绝对路径起 shell）
#   ② PATH 前置垫片目录（claude/dsh 按名字找 shell）
#
# 为什么不挂载：设备上的文件一律用命令读写（cat / sed / heredoc / python -），
# 这些命令已经转发到设备上执行 —— 挂载只会引入 FUSE 的延迟、属主映射和
# 「两份真相」的坑，而 harness 自带文件工具能看到的路径本来也不该由我们伪造。
#
# 用法（在服务器上跑）：
#   device-view [--alias <回连 Host 别名>] [-C <目录>] -- <命令…>
#
# 需要：可用的 unprivileged userns（用来在私有命名空间里替换 shell）。
set -eu

ROOT=${DEVICE_ONBOARD_VIEW_ROOT:-/opt/device-onboard}
ALIAS=
DIR=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --alias) ALIAS=${2:?--alias 后面要跟别名}; shift 2 ;;
        -C)      DIR=${2:?-C 后面要跟目录}; shift 2 ;;
        --)      shift; break ;;
        *)       break ;;
    esac
done
[ "$#" -gt 0 ] || { printf '错误：device-view -- <命令…>\n' >&2; exit 2; }
[ -n "$ALIAS" ] || ALIAS=${DEVICE_ONBOARD_DEVICE_ALIAS:-}
[ -n "$ALIAS" ] || { printf '错误：没有 --alias，也没有 DEVICE_ONBOARD_DEVICE_ALIAS。\n' >&2; exit 2; }

for f in "$ROOT/real-sh" "$ROOT/shim/bash" "$ROOT/shim/zsh"; do
    [ -x "$f" ] || { printf '错误：缺少 %s，先跑 install.sh。\n' "$f" >&2; exit 1; }
done

export DEVICE_ONBOARD_VIEW_ALIAS=$ALIAS

# 内层脚本必须写成**文件**再执行，不能用 `sh -s <<HEREDOC`：
# 那样内层 shell 的 stdin 是 heredoc，交互式 harness 会报 "stdin is not a terminal"。
INNER_SCRIPT=$(mktemp "${TMPDIR:-/tmp}/device-view.XXXXXX") || {
    printf '错误：建不了临时脚本。\n' >&2; exit 1; }
cat > "$INNER_SCRIPT" <<'INNER'
set -eu
ROOT=$1; CWD=$2; shift 2

# ① 让 getpwuid(0) 的家目录指向真实用户的家
#    （ns 里我们是 uid 0，否则 ssh 会去 /root 找 config / known_hosts / 私钥）
mkdir -p /tmp/doview.$$
sed 's|^\(root:x:0:0:root:\)/root:|\1'"$HOME"':|' /etc/passwd > /tmp/doview.$$/passwd
mount --bind /tmp/doview.$$/passwd /etc/passwd

# ② shell 替换：只影响本命名空间。宿主上的 /usr/bin/bash 一个字节都没动。
#    两条路都要堵：按名字从 PATH 找的（claude 用 sh -c），和走绝对路径的（codex 用 bash -lc）。
for s in bash zsh; do
    [ -e "/usr/bin/$s" ] && mount --bind "$ROOT/shim/$s" "/usr/bin/$s"
done
PATH="$ROOT/shim:$PATH"; export PATH

# ③ 工作目录：设备上的路径在这台服务器上并不存在（没有挂载），落在服务器家目录即可；
#    「用户当时在设备上的哪个目录」由 DEVICE_ONBOARD_DEVICE_CWD 环境变量告诉 agent。
cd "$CWD" 2>/dev/null || cd "$HOME" 2>/dev/null || :
"$@"
INNER
chmod 700 "$INNER_SCRIPT"
trap 'rm -f "$INNER_SCRIPT"' EXIT INT TERM
unshare -Urm --map-root-user sh "$INNER_SCRIPT" "$ROOT" "${DIR:-$HOME}" "$@"
